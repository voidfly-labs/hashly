{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~core/*": ["src/core/*"],
      "~styles/*": ["src/styles/*"],
      "~assets/*": ["src/assets/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "checkJs": false
  },
  "include": ["src/**/*", "scripts/**/*", "vite.config.js"],
  "exclude": ["dist", "node_modules", "vendor"]
}
