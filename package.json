{
  "name": "hashly",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "build:all": "node scripts/build.js all",
    "dev": "npx live-server .",
    "download": "node scripts/build.js download",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky"
